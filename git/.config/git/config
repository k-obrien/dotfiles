[include]
    path = ~/.config/git/config.local

[user]
    name = Kieran O'Brien

[core]
    autocrlf = input
    editor = codium --wait
    pager = delta

[url "ssh://git@github.com/"]
    pushInsteadOf = https://github.com/

[init]
    defaultBranch = main

[status]
    submoduleSummary = true

[log]
    date = iso

[submodule]
    recurse = true

[fetch]
    prune = true

[pull]
    rebase = true

[commit]
    gpgSign = true

[push]
    default = current
    autoSetupRemote = true
    useForceIfIncludes = true

[gpg]
    format = ssh

[gpg "ssh"]
    allowedSignersFile = ~/.config/git/allowed_signers

[diff]
    algorithm = histogram
    colorMoved = default
    tool = vscodium
    submodule = diff

[difftool]
    prompt = false

[difftool "vscodium"]
    cmd = codium --wait --diff "$LOCAL" "$REMOTE"

[delta]
    navigate = true
    side-by-side = true
    hyperlinks = true
    map-styles = bold purple => syntax magenta, bold cyan => syntax blue

[merge]
    conflictStyle = zdiff3
    tool = vscodium

[mergetool]
    prompt = false

[mergetool "vscodium"]
    cmd = codium --wait --merge "$LOCAL" "$REMOTE" "$BASE" "$MERGED"
    trustExitCode = true

[rebase]
    autoStash = true
    autoSquash = true
    updateRefs = true

[absorb]
    maxStack = 50
    autoStageIfNothingStaged = true

[alias]
    alias = ! git config --get-regexp alias | cut -c 7-
    edit-config = config --global -e
    clone-with-submodules = clone --recurse-submodules
    clone-submodules = submodule update --init --recursive
    state = status -s
    last = log -1 HEAD
    ls = log --date=format:'%Y/%m/%d %H:%M' --pretty=format:'%C(yellow)%h%C(reset) %C(green)%cd%C(reset) %<(20,mtrunc)%C(blue)%an%C(reset) %s'
    log-with-diff = log -u
    staged = diff --staged
    sprout = "! [ $# -gt 0 ] && git fetch origin "${2:-$(basename "$(git default-branch)")}":"$1" && git checkout "$1" #"
    add-all = add -A
    save = commit -m
    save-all = ! git add-all && git save
    amend-commit = commit --amend --no-edit
    amend-message = commit --amend -m
    add-all-and-amend-commit = ! git add-all && git amend-commit
    add-all-and-amend-message = ! git add-all && git amend-message
    nudge = push --force-with-lease
    undo-commit = reset HEAD~
    unstage-changes = restore --staged
    discard-changes = restore --staged --worktree
    untrack-file = rm --cached
    ignore-tracked-changes = update-index --skip-worktree
    follow-tracked-changes = update-index --no-skip-worktree
    default-branch = symbolic-ref refs/remotes/origin/HEAD --short
    branches = for-each-ref refs/heads --sort=committerdate --format='%(HEAD) %(color:yellow)%(refname:short)%(color:reset) - %(color:red)%(objectname:short)%(color:reset) - %(contents:subject) - %(authorname) (%(color:green)%(committerdate:human)%(color:reset))'
    merged = "! _base_branch=${2:-$(git default-branch)}; git fetch -q && git branch --merged "$_base_branch" | grep -v "$_base_branch" | grep -v '^[*+]' #"
    delete-merged = ! git merged | xargs git branch -d
    delete-merged-forced = ! git merged | xargs git branch -D
    absorb = ! git-absorb
